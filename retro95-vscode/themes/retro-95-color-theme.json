  "semanticHighlighting": true,
  "semanticTokenColors": {
    "comment": "#535353",
    "string": "#006400",
    "keyword": {
      "foreground": "#000080",
      "bold": true
    },
    "function": "#005050",
    "method": "#005050",
    "variable": "#000000",
    "parameter": "#000000",
    "property": "#000000",
    "number": "#800000"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#535353" }
    },
    {
      "scope": "string",
      "settings": { "foreground": "#006400" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#000080", "fontStyle": "bold" }
    },
    {
      "scope": "keyword.operator",
      "settings": { "foreground": "#000000", "fontStyle": "" }
    },
    {
      "scope": ["entity.name.function", "support.function", "variable.function"],
      "settings": { "foreground": "#005050" }
    },
    {
      "scope": ["variable", "variable.parameter", "support.variable"],
      "settings": { "foreground": "#000000" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character.escape"],
      "settings": { "foreground": "#800000" }
    },
    {
      "scope": ["entity.name.type", "support.type", "support.class", "entity.name.tag"],
      "settings": { "foreground": "#000080" }
    },
    {
      "scope": ["invalid", "markup.deleted"],
      "settings": { "foreground": "#800000", "fontStyle": "underline" }
    }
  ]
}
